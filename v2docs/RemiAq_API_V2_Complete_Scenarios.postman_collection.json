    "item": [
        {
            "name": "🔐 AUTH",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData && jsonData.token) {",
                                    "    pm.environment.set(\"auth_token\", jsonData.token);",
                                    "    pm.environment.set(\"user_id\", jsonData.record.id);",
                                    "    console.log(\"✓ Token saved\");",
                                    "    console.log(\"✓ User ID: \" + jsonData.record.id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"identity\": \"test@example.com\",\n  \"password\": \"123123123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/collections/musers/auth-with-password",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "collections",
                                "musers",
                                "auth-with-password"
                            ]
                        }
                    }
                }
            ]
        },
