NUXT_SESSION_PASSWORD=

# Turso — BẮT BUỘC có prefix NUXT_ (Nuxt chỉ nạp env có prefix này)
NUXT_TURSO_DATABASE_URL=
NUXT_TURSO_AUTH_TOKEN=

# FCM (server, gửi push) — private_key phải đặt trong ngoặc kép để giữ \n
NUXT_FCM_CLIENT_EMAIL=
NUXT_FCM_PRIVATE_KEY=
NUXT_FCM_PROJECT_ID=

# Firebase Web (public, an toàn khi lộ ra trình duyệt)
# Lấy ở Firebase Console → Project settings → General → Your apps → SDK setup
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# VAPID key cho Web Push
# Firebase Console → Project settings → Cloud Messaging → Web push certificates
NUXT_PUBLIC_FCM_VAPID_KEY=
